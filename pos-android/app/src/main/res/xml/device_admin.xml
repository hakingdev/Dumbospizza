<?xml version="1.0" encoding="utf-8"?>
<!--
  Политик не запрашиваем: единственное, ради чего нужен админ-приёмник, —
  возможность назначить приложение владельцем устройства (dpm set-device-owner).
  Пустой <uses-policies/> означает «никаких дополнительных прав»: пароль, шифрование
  и удалённое стирание прибору кухни не нужны и просить их незачем.
-->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies />
</device-admin>
